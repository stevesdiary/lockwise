NODE_ENV=test

# JWT Configuration
JWT_SECRET=test_jwt_secret_key_for_testing_only
REFRESH_TOKEN_SECRET=test_refresh_token_secret_key

# Database (will use in-memory SQLite)
DB_DIALECT=sqlite
DB_STORAGE=:memory:

# Redis (will use mock)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Payment Providers (will use mocks)
PAYSTACK_SECRET_KEY=sk_test_mock_paystack_key_12345
PAYSTACK_PUBLIC_KEY=pk_test_mock_paystack_key_12345
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-mock_flutterwave_key_12345
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-mock_flutterwave_key_12345
FLUTTERWAVE_SECRET_HASH=mock_flutterwave_secret_hash

# Email Service (will use mock)
BREVO_API_KEY=test_brevo_api_key_12345
BREVO_SENDER_EMAIL=test@lockwise.com
BREVO_SENDER_NAME=Lockwise Test
ADMIN_EMAIL=admin@test.lockwise.com

# SMS Service (will use mock)
TWILIO_ACCOUNT_SID=test_twilio_account_sid
TWILIO_AUTH_TOKEN=test_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase/FCM (will use mock)
FIREBASE_PROJECT_ID=test-lockwise-project
FIREBASE_PRIVATE_KEY=test_firebase_private_key
FIREBASE_CLIENT_EMAIL=test@lockwise-test.iam.gserviceaccount.com

# Storage (will use mock)
STORAGE_PROVIDER=b2
B2_KEY_ID=test_b2_key_id
B2_APPLICATION_KEY=test_b2_application_key
B2_BUCKET_NAME=test-lockwise-bucket
B2_BUCKET_ID=test_bucket_id_123

# AWS S3 (alternative, will use mock)
AWS_ACCESS_KEY_ID=test_aws_access_key
AWS_SECRET_ACCESS_KEY=test_aws_secret_key
AWS_REGION=us-east-1
STORAGE_BUCKET=test-lockwise-bucket

# OAuth
GOOGLE_CLIENT_ID=test_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=test_google_client_secret

# Application
BASE_URL=http://localhost:3000
PORT=3000
FRONTEND_URL=http://localhost:3001

# Admin Secret (for admin registration)
ADMIN_SECRET_KEY=test_admin_secret_key_12345
