# ─── Database ────────────────────────────────────────────────────────────────
DEV_DB_HOST=your-database-host
DEV_DB_PORT=5432
DEV_DB_USER=your-database-user
DEV_DB_PASSWORD=your-database-password
DEV_DB_NAME=lockwise
SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOCAL_PORT=3002
BASE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
WEB_PORTAL_URL=http://localhost:3000
MOBILE_APP_URL=lockwise://
DEEP_LINK_BASE=lockwise://
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=7d
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_SALT=your-salt-value
ADMIN_SECRET_KEY=your-admin-secret-key

# Max concurrent login sessions per role
MAX_SESSIONS_RESIDENT=3
MAX_SESSIONS_MANAGER=2
MAX_SESSIONS_ADMIN=5
MAX_SESSIONS_SECURITY=2
MAX_SESSIONS_SUPER_ADMIN=3

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/auth/google/callback

# ─── Email (Brevo / Sendinblue) ──────────────────────────────────────────────
SMTP_KEY=your-brevo-api-key
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_SENDER=noreply@lockwise.app
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@lockwise.app
BREVO_SENDER_NAME=Lockwise

# ─── SMS (Twilio) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
SENDER_PHONE_NUMBER=+1234567890

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
REFERRAL_BONUS_PERCENTAGE=10
BIANNUAL_DISCOUNT_PERCENT=5
ANNUAL_DISCOUNT_PERCENT=15

# ─── Firebase (Mobile Push Notifications) ────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Web Push / VAPID (Browser Push for Admin Dashboard) ─────────────────────
# Generate keys: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@lockwise.app

# ─── Async Job Queue (Upstash QStash) ────────────────────────────────────────
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key
WORKER_BASE_URL=http://localhost:3002/api/v1
WORKER_SECRET=your-local-worker-secret

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=b2
STORAGE_BUCKET=your-storage-bucket
STORAGE_ENDPOINT=your-storage-endpoint
B2_ACCESS_KEY_ID=your-b2-access-key
B2_SECRET_ACCESS_KEY=your-b2-secret-key
B2_APPLICATION_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=lockwise-uploads
B2_BUCKET_ID=your-b2-bucket-id

# ─── Security ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=your-32-character-encryption-key
SALT=your-salt-value

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
