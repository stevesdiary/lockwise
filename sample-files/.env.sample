# Database Configuration (Replace with your actual database credentials)
DEV_DB_HOST=your-database-host
DEV_DB_PORT=5432
DEV_DB_USER=your-database-user
DEV_DB_PASSWORD=your-database-password
DEV_DB_NAME=lockwise
SSL=true

# Redis Configuration (Replace with your Redis credentials)
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_USERNAME=default

# JWT Configuration (Generate secure secrets)
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret
REFRESH_TOKEN_EXPIRY=7d

# Email Configuration (Brevo/Sendinblue)
SMTP_KEY=your-brevo-api-key
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_SENDER=your-sender-email@domain.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
SENDER_PHONE_NUMBER=+1234567890

# Payment Configuration
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_flutterwave_secret_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key

# Firebase Configuration (Push Notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# Security Configuration
ENCRYPTION_KEY=your-32-character-encryption-key
SALT=your-salt-value

# Application Configuration
LOCAL_PORT=3000
BASE_URL=http://localhost:3000
DEEP_LINK_BASE=lockwise://

# Cloud Storage (Optional - Backblaze B2 or AWS S3)
STORAGE_BUCKET=your-storage-bucket
STORAGE_ENDPOINT=your-storage-endpoint
B2_ACCESS_KEY_ID=your-b2-access-key
B2_SECRET_ACCESS_KEY=your-b2-secret-key