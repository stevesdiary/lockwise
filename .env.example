# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lockwise
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=your-jwt-secret-key

# Max concurrent login sessions per role
MAX_SESSIONS_RESIDENT=3
MAX_SESSIONS_MANAGER=2
MAX_SESSIONS_ADMIN=5
MAX_SESSIONS_SECURITY=2
MAX_SESSIONS_SUPER_ADMIN=3

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/auth/google/callback

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key
# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_key
FLUTTERWAVE_SECRET_HASH=your_webhook_hash
BASE_URL=http://localhost:3000

# File Storage Provider
STORAGE_PROVIDER=b2

# Backblaze B2
B2_APPLICATION_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=lockwise-uploads
B2_BUCKET_ID=your-b2-bucket-id

# AWS S3 (alternative — set STORAGE_PROVIDER=aws)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# STORAGE_BUCKET=lockwise-uploads
# STORAGE_ENDPOINT=

# ─── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── WhatsApp (optional) ─────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_API_URL=https://api.whatsapp.com/v1
SUPPORT_WHATSAPP=+2348000000000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info


VTPASS_API_KEY=<your_key>
VTPASS_SECRET_KEY=<your_secret>

# ─── Kuda Business API (estate virtual wallets) ───────────────────────────────
# Obtain credentials from the Kuda Business dashboard
# Leave blank to disable — wallet endpoints return 503 when KUDA_API_KEY is unset
KUDA_BASE_URL=https://kuda-openapi.kuda.com/v2.1
KUDA_API_KEY=your-kuda-api-key
KUDA_MERCHANT_KEY=your-kuda-merchant-key
KUDA_WEBHOOK_SECRET=your-kuda-webhook-secret

