# Database
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# JWT
JWT_SECRET=your-jwt-secret-key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key
BASE_URL=http://localhost:3000

# Subscription discounts (percentage, e.g. 5 = 5%)
BIANNUAL_DISCOUNT_PERCENT=5
ANNUAL_DISCOUNT_PERCENT=15

# Max concurrent login sessions per role
MAX_SESSIONS_RESIDENT=3
MAX_SESSIONS_MANAGER=2
MAX_SESSIONS_ADMIN=5
MAX_SESSIONS_SECURITY=5
MAX_SESSIONS_SUPER_ADMIN=3

# File Storage Provider
STORAGE_PROVIDER=b2

# Backblaze B2 Configuration
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=lockwise-uploads
B2_BUCKET_ID=your_b2_bucket_id

# AWS S3 Configuration (Alternative)
# STORAGE_PROVIDER=aws
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# STORAGE_BUCKET=lockwise-uploads

# Brevo Email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@domain.com
BREVO_SENDER_NAME=Lockwise

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=3001
NODE_ENV=development