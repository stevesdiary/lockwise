# ─── Database ────────────────────────────────────────────────────────────────
# Option A: full connection string (takes precedence)
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Option B: individual fields
DB_HOST=localhost
DB_PORT=5432
DB_USER=lockwise
DB_PASSWORD=your-db-password
DB_NAME=lockwise
DB_DIALECT=postgres

# SSL (set DB_SSL=true in production)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_SSL_CA=

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOCAL_PORT=3002
BASE_URL=http://localhost:3002
FRONTEND_URL=http://localhost:3000
WEB_PORTAL_URL=http://localhost:3000
MOBILE_APP_URL=lockwise://
DEEP_LINK_BASE=lockwise://

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRY=15m
REFRESH_TOKEN_SECRET=your-refresh-token-secret
ENCRYPTION_KEY=your-32-character-encryption-key
ENCRYPTION_SALT=your-salt-value
ADMIN_SECRET_KEY=your-admin-secret-key

# Max concurrent login sessions per role
MAX_SESSIONS_RESIDENT=3
MAX_SESSIONS_MANAGER=2
MAX_SESSIONS_ADMIN=5
MAX_SESSIONS_SECURITY=5
MAX_SESSIONS_SUPER_ADMIN=3

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3002/api/v1/auth/google/callback

# ─── Payments (Paystack) ─────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key
REFERRAL_PORTAL_BASE_URL=http://localhost:3002
REFERRAL_BONUS_PERCENTAGE=10

# Subscription discounts (percentage, e.g. 5 = 5%)
BIANNUAL_DISCOUNT_PERCENT=5
ANNUAL_DISCOUNT_PERCENT=15

# ─── Email (Brevo / Sendinblue) ──────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@lockwise.app
BREVO_SENDER_NAME=Lockwise

# ─── SMS (Twilio) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ─── Firebase (Mobile Push Notifications) ────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Web Push / VAPID (Browser Push for Admin Dashboard) ─────────────────────
# Generate keys: node -e "const wp=require('web-push'); const k=wp.generateVAPIDKeys(); console.log(k)"
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@lockwise.app

# ─── Async Job Queue (Upstash QStash) ────────────────────────────────────────
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-qstash-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-qstash-next-signing-key
# URL QStash posts jobs back to (must be publicly reachable in production)
WORKER_BASE_URL=http://localhost:3002/api/v1
# Local dev bypass secret (used instead of QStash signature when NODE_ENV != production)
WORKER_SECRET=your-local-worker-secret

# ─── Redis (Upstash) ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ─── File Storage ────────────────────────────────────────────────────────────
STORAGE_PROVIDER=b2

# Backblaze B2
B2_APPLICATION_KEY_ID=your-b2-application-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=lockwise-uploads
B2_BUCKET_ID=your-b2-bucket-id

# AWS S3 (alternative — set STORAGE_PROVIDER=aws)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# STORAGE_BUCKET=lockwise-uploads
# STORAGE_ENDPOINT=

# ─── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ─── WhatsApp (optional) ─────────────────────────────────────────────────────
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_API_URL=https://api.whatsapp.com/v1
SUPPORT_WHATSAPP=+2348000000000

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
