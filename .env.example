# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lockwise
DB_USER=postgres
DB_PASSWORD=password

# JWT
JWT_SECRET=your-jwt-secret-key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_key
PAYSTACK_PUBLIC_KEY=pk_test_your_key
# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_key
FLUTTERWAVE_SECRET_HASH=your_webhook_hash
BASE_URL=http://localhost:3000

# File Storage Provider
STORAGE_PROVIDER=b2

# Backblaze B2 Configuration
B2_APPLICATION_KEY_ID=your_b2_application_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=lockwise-uploads
B2_BUCKET_ID=your_b2_bucket_id

# AWS S3 Configuration (Alternative)
# STORAGE_PROVIDER=aws
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# STORAGE_BUCKET=lockwise-uploads

# Brevo Email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@domain.com
BREVO_SENDER_NAME=Lockwise

# Redis
REDIS_URL=redis://localhost:6379

# App
PORT=3000
NODE_ENV=development