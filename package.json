  "main": "index.js",
  "scripts": {
    "start": "tsc && node ./build/src/main.js",
    "migrate": "npx sequelize-cli db:migrate",
    "test": "NODE_ENV=test jest --config tests/setup/jest.config.ts",
    "test:watch": "NODE_ENV=test jest --watch --config tests/setup/jest.config.ts",
    "test:coverage": "NODE_ENV=test jest --coverage --config tests/setup/jest.config.ts",
    "test:unit": "NODE_ENV=test jest tests/unit --config tests/setup/jest.config.ts",
    "test:integration": "NODE_ENV=test jest tests/integration --config tests/setup/jest.config.ts",
    "test:auth": "NODE_ENV=test jest tests/integration/auth --config tests/setup/jest.config.ts",
    "test:payments": "NODE_ENV=test jest tests/integration/payments --config tests/setup/jest.config.ts",
    "test:rbac": "NODE_ENV=test jest tests/integration/rbac --config tests/setup/jest.config.ts"
  },
