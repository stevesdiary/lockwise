{
  "name": "lockwise",
  "version": "1.0.0",
  "description": "gatekeeper",
  "homepage": "https://github.com/stevesdiary/lockwise#readme",
  "bugs": {
    "url": "https://github.com/stevesdiary/lockwise/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevesdiary/lockwise.git"
  },
  "license": "ISC",
  "author": "Stephen Oyeyemi",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "tsc && node ./build/src/main.js",
    "dev": "ts-node src/main.ts",
    "dev:watch": "nodemon --watch src --ext ts --exec ts-node src/main.ts",
    "db:diagnose": "tsc && node ./build/src/scripts/db-diagnose.js",
    "migrate": "tsc && node ./build/src/scripts/migrate.js",
    "seed": "npx sequelize-cli db:seed:all",
    "test": "NODE_ENV=test jest --config tests/setup/jest.config.ts",
    "test:watch": "NODE_ENV=test jest --watch --config tests/setup/jest.config.ts",
    "test:coverage": "NODE_ENV=test jest --coverage --config tests/setup/jest.config.ts",
    "test:unit": "NODE_ENV=test jest tests/unit --config tests/setup/jest.config.ts",
    "test:integration": "NODE_ENV=test jest tests/integration --config tests/setup/jest.config.ts",
    "test:auth": "NODE_ENV=test jest tests/integration/auth --config tests/setup/jest.config.ts",
    "test:payments": "NODE_ENV=test jest tests/integration/payments --config tests/setup/jest.config.ts",
    "test:rbac": "NODE_ENV=test jest tests/integration/rbac --config tests/setup/jest.config.ts",
    "load:baseline": "k6 run -e STAGE=baseline tests/load/journey.js",
    "load:stress": "k6 run -e STAGE=stress   tests/load/journey.js",
    "load:spike": "k6 run -e STAGE=spike    tests/load/journey.js",
    "load:all": "k6 run tests/load/journey.js",
    "load:seed": "npx sequelize-cli db:seed --seed seeders/loadtest-seed-users.js",
    "load:seed:undo": "npx sequelize-cli db:seed:undo --seed seeders/loadtest-seed-users.js",
    "test:breakpoint": "k6 run load-test/tests/breakpoint.js",
    "test:smoke": "k6 run load-test/tests/smoke.js",
    "test:load": "k6 run load-test/tests/load.js",
    "test:stress": "k6 run load-test/tests/stress.js",
    "test:spike": "k6 run load-test/tests/spike.js",
    "test:full": "k6 run load-test/tests/full-load-test.js",
    "test:resident": "k6 run --vus 20 --duration 3m load-test/tests/scenarios/resident-journey-standalone.js",
    "test:manager": "k6 run --vus 10 --duration 3m load-test/tests/scenarios/manager-journey-standalone.js",
    "test:queue": "k6 run --vus 5 --duration 2m load-test/tests/scenarios/queue-backpressure-standalone.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.46.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.1",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.52.1",
    "@types/axios": "^0.9.36",
    "@types/backblaze-b2": "^1.5.6",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/bull": "^3.15.9",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^6.1.1",
    "@types/express-rate-limit": "^5.1.3",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^2.0.0",
    "@types/nanoid": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/socket.io": "^3.0.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/web-push": "^3.6.4",
    "@types/xlsx": "^0.0.35",
    "@types/yup": "^0.29.14",
    "@upstash/qstash": "^2.10.1",
    "@upstash/redis": "^1.37.0",
    "axios": "^1.9.0",
    "backblaze-b2": "^1.7.1",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nanoid": "^3.3.7",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.11.1",
    "umzug": "^3.8.2",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "xlsx": "^0.18.5",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@secretlint/quick-start": "^13.0.0",
    "@secretlint/secretlint-rule-aws": "^13.0.0",
    "@secretlint/secretlint-rule-basicauth": "^13.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
    "@secretlint/secretlint-rule-privatekey": "^13.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.0",
    "@types/nodemailer": "^7.0.4",
    "@types/pg": "^8.16.0",
    "@types/sequelize": "^6.12.0",
    "@types/supertest": "^6.0.3",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "nodemon": "^3.1.9",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.3",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
